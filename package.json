{
  "name": "kontas",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint:biome": "biome check .",
    "fix:biome": "biome check --write .",
    "format": "biome format --write .",
    "lint": "expo lint",
    "test": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "sonar:scan": "jest --coverage --ci && docker compose --env-file .env run --rm node-sonar"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": ["/node_modules/", "/android/", "/dist/"],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "setupFiles": [
      "<rootDir>/src/test/jest.setup.ts",
      "react-native-reanimated/mock"
    ],
    "coverageReporters": ["lcov", "text"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/*.test.{ts,tsx}",
      "!**/*.spec.{ts,tsx}",
      "!**/node_modules/**",
      "!**/android/**",
      "!**/dist/**",
      "!**/coverage/**",
      "!**/scripts/**"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/mulish": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.2",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-clipboard": "^8.0.7",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.9",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-test-renderer": "19.1.0",
    "sonner-native": "^0.22.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@expo/cli": "^54.0.22",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "expo-atlas": "^0.4.0",
    "jest": "~29.7.0",
    "jest-expo": "^55.0.16",
    "react-native-svg-transformer": "^1.5.2",
    "sonarqube-scanner": "^3.5.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  },
  "private": true
}
